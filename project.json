{
  "projectType": "application",
  "sourceRoot": "src",
  "prefix": "app",
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "src/**/*.ts"
        ]
      }
    }
  }
}
