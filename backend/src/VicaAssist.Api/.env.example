# Copy to .env (git-ignored) and fill in. Values already set in the real environment win over this file.
# "__" separates configuration sections, as in environment variables.

# Required. At least 32 characters. Generate one with: openssl rand -base64 48
Jwt__SigningKey=

# Required while the database has no users: the password given to the seeded sample users.
Seed__Password=

# Optional; the defaults are shown.
# Jwt__Issuer=vica-assist-api
# Jwt__Audience=vica-assist-app
# Jwt__AccessTokenMinutes=15
# Jwt__RefreshTokenDays=30
# Jwt__SessionRefreshTokenHours=12
# Cors__AllowedOrigin=http://localhost:4200
# Data__FilePath=App_Data/database.json
# PasswordReset__TokenMinutes=60
# RateLimit__AuthRequestsPerMinute=10
