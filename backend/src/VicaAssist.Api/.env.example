# Copy to .env (git-ignored) and fill in. Keep secrets here, not in appsettings*.json.
#
# Settings are read in this order, later sources winning: appsettings.json, appsettings.<Environment>.json,
# this file, then real environment variables. "__" separates sections, so Jwt__SigningKey is Jwt:SigningKey.
# Any setting from appsettings.json can be overridden here the same way (for example Jwt__AccessTokenMinutes=30).

# Required. At least 32 characters. Generate one with: openssl rand -base64 48
Jwt__SigningKey=

# Required while the database has no users: the password given to the seeded sample users (8+ characters).
Seed__Password=
