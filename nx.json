{
  "extends": "nx/presets/npm.json",
  "targetDefaults": {
    "prepare": {
      "dependsOn": [
        "^prepare"
      ]
    },
    "package": {
      "dependsOn": [
        "^package"
      ]
    }
  },
  "affected": {
    "defaultBase": "master"
  },
  "workspaceLayout": {
    "libsDir": "projects",
    "appsDir": "projects"
  },
  "defaultProject": "vica-assist",
  "generators": {
    "@nrwl/angular:application": {
      "linter": "eslint",
      "unitTestRunner": "jest"
    },
    "@nrwl/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "jest"
    },
    "@nrwl/angular:component": {}
  },
  "analytics": false
}