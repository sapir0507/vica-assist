{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "noUnusedLocals": true,
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "*": ["./*"],
      "@vica-assist/my-flights": [
        "projects/my-flights/src/index.ts"
      ],
      "@vica-assist/my-hotels": [
        "projects/my-hotels/src/index.ts"
      ],
      "@vica-assist/my-pipes": [
        "projects/my-pipes/src/index.ts"
      ],
      "@vica-assist/item": [
        "projects/item/src/item.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
