{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "vica-assist": {
      "root": ".",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/vica-assist",
            "index": "src/index.html",
            "polyfills": [
              "zone.js",
              "@angular/localize/init"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/deeppurple-amber.css",
              "src/styles.scss"
            ],
            "scripts": [],
            "browser": "src/main.ts"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "2.5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "200kb",
                  "maximumError": "250kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "testing": {
              "aot": false,
              "optimization": false,
              "extractLicenses": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "vica-assist:build:production"
            },
            "development": {
              "buildTarget": "vica-assist:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "vica-assist:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "reporters": [
              "default"
            ],
            "coverageReporters": [
              "html",
              "text-summary"
            ],
            "buildTarget": "vica-assist:build:testing",
            "runner": "vitest"
          }
        }
      },
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      }
    },
    "item": {
      "projectType": "library",
      "root": "projects/item",
      "sourceRoot": "projects/item/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/item/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/item/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/item/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/item/tsconfig.spec.json",
            "buildTarget": "vica-assist:build:testing"
          }
        }
      }
    },
    "mat-input": {
      "projectType": "library",
      "root": "projects/mat-input",
      "sourceRoot": "projects/mat-input/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/mat-input/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/mat-input/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/mat-input/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/mat-input/tsconfig.spec.json",
            "buildTarget": "vica-assist:build:testing"
          }
        }
      }
    },
    "my-flights": {
      "projectType": "library",
      "root": "projects/my-flights",
      "sourceRoot": "projects/my-flights/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/my-flights/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/my-flights/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/my-flights/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/my-flights/tsconfig.spec.json",
            "buildTarget": "vica-assist:build:testing"
          }
        }
      }
    },
    "my-hotels": {
      "projectType": "library",
      "root": "projects/my-hotels",
      "sourceRoot": "projects/my-hotels/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "defaultConfiguration": "production",
          "options": {
            "project": "projects/my-hotels/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/my-hotels/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/my-hotels/tsconfig.lib.json"
            }
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/my-hotels/tsconfig.spec.json",
            "buildTarget": "vica-assist:build:testing"
          }
        }
      }
    },
    "my-pipes": {
      "projectType": "library",
      "root": "projects/my-pipes",
      "sourceRoot": "projects/my-pipes/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "defaultConfiguration": "production",
          "options": {
            "project": "projects/my-pipes/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/my-pipes/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/my-pipes/tsconfig.lib.json"
            }
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/my-pipes/tsconfig.spec.json",
            "buildTarget": "vica-assist:build:testing"
          }
        }
      }
    },
    "shared": {
      "projectType": "library",
      "root": "projects/shared",
      "sourceRoot": "projects/shared/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/shared/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/shared/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/shared/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/shared/tsconfig.spec.json",
            "buildTarget": "vica-assist:build:testing"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
