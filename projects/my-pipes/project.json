{
  "name": "@vica-assist/my-pipes",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "projects/my-pipes/src",
  "prefix": "vica-assist",
  "targets": {
    "build": {
      "executor": "@angular/build:ng-packagr",
      "outputs": [
        "{workspaceRoot}/dist/projects/my-pipes"
      ],
      "defaultConfiguration": "production",
      "options": {
        "project": "projects/my-pipes/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "projects/my-pipes/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "projects/my-pipes/tsconfig.lib.json"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "tsConfig": "projects/my-pipes/tsconfig.spec.json",
        "buildTarget": "vica-assist:build:testing"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "projects/my-pipes/src/**/*.ts",
          "projects/my-pipes/src/**/*.html"
        ]
      }
    }
  }
}
