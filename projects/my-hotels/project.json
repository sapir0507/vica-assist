{
  "name": "my-hotels",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "projects/my-hotels/src",
  "prefix": "lib",
  "targets": {
    "build": {
      "executor": "@angular/build:ng-packagr",
      "defaultConfiguration": "production",
      "options": {
        "project": "projects/my-hotels/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "projects/my-hotels/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "projects/my-hotels/tsconfig.lib.json"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "projects/my-hotels/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/projects/my-hotels"
      ],
      "options": {
        "jestConfig": "projects/my-hotels/jest.config.ts",
        "passWithNoTests": true
      }
    }
  }
}
